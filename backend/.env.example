# =====================================================================
# Skill Market 后端环境变量（复制为 backend/.env 使用）
#   cp backend/.env.example backend/.env
# =====================================================================

# ── 大模型（智能体对话，OpenAI 兼容） ─────────────────────────────────
# 未设置 LLM_* 时会自动回退 DASHSCOPE_API_KEY / DASHSCOPE_BASE_URL。
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus

# 智能体工具循环上限（安全网，非业务流控）
AGENT_MAX_STEPS=100

# 上下文压缩：超过该字符数触发历史压缩，压缩时保留最近 N 条消息
SUMMARY_TRIGGER_CHARS=60000
SUMMARY_KEEP_MESSAGES=8

# ── 技能脚本运行凭证 ──────────────────────────────────────────────────
# 后端只向技能脚本子进程透传白名单里的环境变量（见 app/agent/safety.py）。
# 如果你的技能需要读取额外变量，把它们列在这里（逗号分隔），
# 例如： SKILL_ENV_PASSTHROUGH=MY_API_KEY,MY_ENDPOINT
SKILL_ENV_PASSTHROUGH=

# ── SkillHub 集成（可选：把 SkillHub 作为技能源） ─────────────────────
# 不配置 SKILLHUB_URL 时跳过同步，市场只展示 backend/app/skills/ 下的本地技能。
SKILLHUB_URL=
# 访问受限技能时需要；公开技能留空即可。
SKILLHUB_TOKEN=
# 可选：只同步指定命名空间（逗号分隔）；SKILLHUB_SYNC_LIMIT 限制拉取数量（0=不限）
SKILLHUB_SYNC_NAMESPACES=
SKILLHUB_SYNC_LIMIT=0

# 批量发布脚本 publish_to_skillhub.py 用的管理员凭据（仅本地演示用，请自行修改）
SKILLHUB_ADMIN_USERNAME=admin
SKILLHUB_ADMIN_PASSWORD=change-me-local-demo
